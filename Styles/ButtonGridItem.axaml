<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Button.gridItem">
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="CornerRadius" Value="3" />
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
        </Style>
        <Style Selector="^.currentSelection /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="DodgerBlue" />
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="RenderTransform" Value="scale(0.98)" />
        </Style>

        <Style Selector="^.phrase">
            <Setter Property="FontSize" Value="16" />

            <Style Selector="^.high">
                <Setter Property="Foreground" Value="DodgerBlue" />
                <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Background" Value="DodgerBlue" />
                </Style>
            </Style>

            <Style Selector="^.low">
                <Setter Property="Foreground" Value="IndianRed" />
                <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Background" Value="IndianRed" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^.element">
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="72" />
            <Setter Property="Foreground" Value="Black" />

            <Style Selector="^ > StackPanel > TextBlock">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="36" />
            </Style>

            <Style Selector="^ > StackPanel > Border">
                <Setter Property="Background" Value="White" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Padding" Value="2 1" />
                <Setter Property="Margin" Value="0 3" />
                <Setter Property="CornerRadius" Value="2" />
                <Style Selector="^ > TextBlock">
                    <Setter Property="Foreground" Value="Black" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontFamily" Value="System" />
                </Style>
            </Style>

            <Style Selector="^.high">
                <Style Selector="^ > StackPanel > TextBlock">
                    <Setter Property="Foreground" Value="MediumSeaGreen" />
                </Style>
                <Style Selector="^ > StackPanel > Border">
                    <Setter Property="Background" Value="MediumSeaGreen" />
                </Style>
                <Style Selector="^:pointerover > StackPanel > TextBlock">
                    <Setter Property="Foreground" Value="Black" />
                </Style>
                <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Foreground" Value="Black" />
                    <Setter Property="Background" Value="MediumSeaGreen" />
                </Style>
            </Style>

            <Style Selector="^.medium">
                <Style Selector="^ > StackPanel > TextBlock">
                    <Setter Property="Foreground" Value="DarkGoldenrod" />
                </Style>
                <Style Selector="^ > StackPanel > Border">
                    <Setter Property="Background" Value="DarkGoldenrod" />
                </Style>
                <Style Selector="^:pointerover > StackPanel > TextBlock">
                    <Setter Property="Foreground" Value="Black" />
                </Style>
                <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Foreground" Value="Black" />
                    <Setter Property="Background" Value="DarkGoldenrod" />
                </Style>
            </Style>

            <Style Selector="^.low">
                <Style Selector="^ > StackPanel > TextBlock">
                    <Setter Property="Foreground" Value="IndianRed" />
                </Style>
                <Style Selector="^ > StackPanel > Border">
                    <Setter Property="Background" Value="IndianRed" />
                </Style>
                <Style Selector="^:pointerover > StackPanel > TextBlock">
                    <Setter Property="Foreground" Value="Black" />
                </Style>
                <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Foreground" Value="Black" />
                    <Setter Property="Background" Value="IndianRed" />
                </Style>
            </Style>

            <Style Selector="^.selected">
                <Style Selector="^ > StackPanel > TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource AccentButtonBackground}" />
                </Style>
                <Style Selector="^:pointerover > StackPanel > TextBlock">
                    <Setter Property="Foreground" Value="Black" />
                </Style>
                <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Foreground" Value="Black" />
                    <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
                </Style>
            </Style>
        </Style>
    </Style>
</Styles>
