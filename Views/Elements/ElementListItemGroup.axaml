<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:Descript.Models"
             xmlns:elements="clr-namespace:Descript.Views.Elements"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Descript.Views.Elements.ElementListItemGroup"
             x:DataType="models:ElementGroup">
    
    <StackPanel Orientation="Horizontal">
        <elements:ElementListItem DataContext="{Binding Element1}"/>
        <elements:ElementListItem DataContext="{Binding Element2}" IsVisible="{Binding Id, FallbackValue='False'}"/>
        <elements:ElementListItem DataContext="{Binding Element3}" IsVisible="{Binding Id, FallbackValue='False'}"/>
        <elements:ElementListItem DataContext="{Binding Element4}" IsVisible="{Binding Id, FallbackValue='False'}"/>
    </StackPanel>
</UserControl>
