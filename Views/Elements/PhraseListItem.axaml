<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Descript.ViewModels"
             xmlns:views="clr-namespace:Descript.Views"
             xmlns:utils="clr-namespace:Descript.Utils"
             xmlns:models="clr-namespace:Descript.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Descript.Views.Elements.PhraseListItem"
             x:DataType="models:Phrase">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <utils:StringNotEmptyConverter x:Key="StringNotEmptyConverter"/>
            <utils:ConfidenceLevelToBrushConverter x:Key="ConfidenceToBrushConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Button HorizontalAlignment="Stretch"
            Classes.gridItem="True"
            Command="{Binding $parent[views:ViewPhrases].((vm:ViewModelPhrases)DataContext).PrimaryCommand, FallbackValue=''}"
            CommandParameter="{Binding Glyphs}" >
                            <StackPanel Orientation="Horizontal">
                                <Label Content="{Binding Glyphs}"
                                       FontSize="16"
                                       Foreground="{Binding Confidence, Converter={StaticResource ConfidenceToBrushConverter}}"/>
                                <Label Content="-"
                                       FontSize="16"
                                       IsVisible="{Binding Translation, Converter={StaticResource StringNotEmptyConverter}}"
                                       Foreground="{Binding Confidence, Converter={StaticResource ConfidenceToBrushConverter}}"/>
                                <Label Content="{Binding Translation}"
                                       FontSize="16"
                                       IsVisible="{Binding Translation, Converter={StaticResource StringNotEmptyConverter}}"
                                       Foreground="{Binding Confidence, Converter={StaticResource ConfidenceToBrushConverter}}"/>
                            </StackPanel>
                            <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Edit" 
                                          Command="{Binding $parent[views:ViewPhrases].((vm:ViewModelPhrases)DataContext).EditPhraseCommand, FallbackValue=''}" 
                                          CommandParameter="{Binding Glyphs}" />
                                <MenuItem Header="Copy" 
                                          Command="{Binding $parent[views:ViewPhrases].((vm:ViewModelPhrases)DataContext).CopyCommand, FallbackValue=''}" 
                                          CommandParameter="{Binding Glyphs}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        </Button>
</UserControl>
