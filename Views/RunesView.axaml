<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:Descript.Views.Controls"
             xmlns:vm="using:Descript.ViewModels"
             xmlns:models="clr-namespace:Descript.Models"
             xmlns:utils="clr-namespace:Descript.Utils"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Descript.Views.RunesView"
             x:DataType="vm:ViewModelMainWindow">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <utils:StringNotEmptyConverter x:Key="StringNotEmptyConverter"/>
            <utils:ConfidenceLevelToBrushConverter x:Key="ConfidenceToBrushConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <UserControl.Styles>
        <Style Selector="Button.currentSelection">
            <Setter Property="Background" Value="DarkSlateBlue"/>
        </Style>
    </UserControl.Styles>
    
    <Grid RowDefinitions="256,16,*" RowSpacing="8">
        
        <controls:SegmentSelectControl Grid.Row="0" 
                                       AccentColor="{DynamicResource SystemAccentColor}"
                                       Selection="{Binding ViewModelRune.CurrentSelection, Mode=TwoWay}" />
                    
        <TextBox Grid.Row="1" PlaceholderText="Filter Runes by Translation" 
                 Text="{Binding ViewModelRune.FilterText}">
            <TextBox.InnerRightContent>
                <Button Grid.Column="0"
                        Content="x"
                        Classes="cancel"
                        IsVisible="{Binding ViewModelRune.CanClearFilters}"
                        Command="{Binding ClearRuneListFiltersCommand}" />
            </TextBox.InnerRightContent>
        </TextBox>
        
        <ScrollViewer Grid.Row="2" x:Name="ScrollView" VerticalScrollBarVisibility="Visible" AllowAutoHide="False">
            <ItemsControl ItemsSource="{Binding ViewModelRune.RunesFiltered}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="models:Rune">
                        <Button Command="{Binding $parent[Window].((vm:ViewModelMainWindow)DataContext).PrimaryCommand, FallbackValue=''}"
                                CommandParameter="{Binding Glyph}"
                                Focusable="False"
                                Width="54" 
                                Height="78" 
                                Theme="{StaticResource GridItem}"
                                Classes.currentSelection="{Binding IsCurrentSelection}">
                            <Grid RowDefinitions="*,16,5">
                                <Label Grid.Row="0"
                                       Margin="0"
                                       Padding="0"
                                       Content="{Binding Glyph}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top"
                                       Foreground="{Binding Confidence, Converter={StaticResource ConfidenceToBrushConverter}}"
                                       FontSize="40" />
                                <Label Grid.Row="1"
                                       Margin="0"
                                       Padding="3 0"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Content="{Binding Translation}"
                                       CornerRadius="3"
                                       IsVisible="{Binding Translation, Converter={StaticResource StringNotEmptyConverter}}"
                                       Foreground="Black"
                                       Background="{Binding Confidence, Converter={StaticResource ConfidenceToBrushConverter}}"
                                       FontSize="13" />
                            </Grid>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Edit" 
                                              Command="{Binding $parent[Window].((vm:ViewModelMainWindow)DataContext).OpenRuneEditDialogCommand, FallbackValue=''}" 
                                              CommandParameter="{Binding Glyph}" />
                                    <MenuItem Header="Copy" 
                                              Command="{Binding $parent[Window].((vm:ViewModelMainWindow)DataContext).CopyTextToClipboardCommand, FallbackValue=''}" 
                                              CommandParameter="{Binding Glyph}" />
                                    <MenuItem Header="Delete" 
                                              Foreground="OrangeRed"
                                              Command="{Binding $parent[Window].((vm:ViewModelMainWindow)DataContext).DeleteRuneCommand, FallbackValue=''}" 
                                              CommandParameter="{Binding Glyph}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Margin="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
