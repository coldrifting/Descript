<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Descript.ViewModels"
        xmlns:c="using:Descript.Views.Controls"
        xmlns:m="using:Descript.Models"
        xmlns:u="using:Descript.Utils"
        xmlns:dh="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="720"
        x:Class="Descript.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        x:Name="Root"
        Title="Descript">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <u:RuneLabelVisibleConverter x:Key="RuneLabelVisibleConverter"/>
            <u:ConfidenceLevelToBrushConverter x:Key="ConfidenceToBrushConverter"/>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AccentColor">RoyalBlue</SolidColorBrush>
                    <SolidColorBrush x:Key="ActionColor">DarkSlateBlue</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <dh:DialogHostStyles />
        <Style Selector="Button.gridListItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.gridListItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
        </Style>
        <Style Selector="Button.gridListItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ActionColor}" />
        </Style>
    </Window.Styles>

    <dh:DialogHost CloseOnClickAway="True" IsOpen="{Binding IsDialogOpen, Mode=TwoWay}">
        <dh:DialogHost.DialogContent>
            <StackPanel>
                <TextBlock HorizontalAlignment="Center" Margin="5">Input Translation Guess</TextBlock>
                <Grid RowDefinitions="50,50" ColumnDefinitions="100,200" Margin="5">
                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">Translation</TextBlock>
                <TextBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" IsFocused="{Binding IsDialogFocused, Mode=TwoWay}" Text="{Binding RuneEditNewTranslation}" />
                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">Confidence</TextBlock>
                <ComboBox Grid.Row="1" Grid.Column="1" Width="200" VerticalAlignment="Center" ItemsSource="{Binding ConfidenceLevels}" SelectedValue="{Binding RuneEditNewConfidenceLevel}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                </Grid>
                <Button IsEnabled="{Binding RuneEditNewTranslationOkay}"
                        Command="{Binding SubmitDialogCommand}"
                        Content="Submit"
                        Margin="2"
                        HorizontalAlignment="Right"/>
            </StackPanel>
        </dh:DialogHost.DialogContent>

        <Grid ColumnDefinitions="306,*">
            <Grid Grid.Column="0" RowDefinitions="256,32,32,*">
                <c:SegmentSelect Grid.Row="0" 
                                        AccentColor="{DynamicResource AccentColor}"
                                        Selection="{Binding RunesList.CurrentSelection, Mode=TwoWay}" />

                <Grid Grid.Row="1" ColumnDefinitions="*,*,*">
                    <Button Grid.Column="0"
                            HorizontalAlignment="Center"
                            Content="Clear"
                            IsEnabled="{Binding RunesList.CanClearFilters}"
                            Command="{Binding ClearRuneListFiltersCommand}" />
                    <Button Grid.Column="1"
                            HorizontalAlignment="Center"
                            Content="Add"
                            IsEnabled="{Binding RunesList.CanAddRune}"
                            Command="{Binding AddRuneCommand}" 
                            CommandParameter="{Binding RunesList.CurrentSelection}"/>
                    <Button Grid.Column="2"
                            HorizontalAlignment="Center"
                            Command="{Binding ToggleRuneListSortModeCommand}"
                            Content="{Binding RunesList.SortModeString}"/>
                </Grid>
                
                <TextBox Grid.Row="2" Watermark="Search by Translation" Text="{Binding RunesList.FilterText}"/>

                <ScrollViewer Grid.Row="3" x:Name="ScrollView" VerticalScrollBarVisibility="Visible"
                              AllowAutoHide="False">
                    <ItemsControl ItemsSource="{Binding RunesList.Runes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="m:Rune">
                                <Button Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).CopyTextToClipboardCommand , FallbackValue=''}"
                                        CommandParameter="{Binding Glyph}"
                                        Width="64" 
                                        Height="78" 
                                        Margin="3" 
                                        Padding="0" 
                                        Classes="gridListItem"
                                        CornerRadius="3" 
                                        BorderThickness="3">
                                    <Grid RowDefinitions="*,16,5">
                                        <Label Grid.Row="0"
                                               Margin="0"
                                               Padding="0"
                                               Content="{Binding Glyph}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Top"
                                               Foreground="{Binding Confidence, Converter={StaticResource ConfidenceToBrushConverter}}"
                                               FontSize="40" />
                                        <Label Grid.Row="1"
                                               Margin="0"
                                               Padding="3 0"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Content="{Binding Translation}"
                                               CornerRadius="3"
                                               IsVisible="{Binding Translation, Converter={StaticResource RuneLabelVisibleConverter}}"
                                               Foreground="Black"
                                               Background="{Binding Confidence, Converter={StaticResource ConfidenceToBrushConverter}}"
                                               FontSize="13" />
                                    </Grid>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Edit" 
                                                      Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).OpenRuneEditDialogCommand , FallbackValue=''}" 
                                                      CommandParameter="{Binding Id}" />
                                            <MenuItem Header="Copy" 
                                                      Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).CopyTextToClipboardCommand , FallbackValue=''}" 
                                                      CommandParameter="{Binding Glyph}" />
                                            <MenuItem Header="Delete" 
                                                      Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).DeleteRuneCommand , FallbackValue=''}" 
                                                      CommandParameter="{Binding Id}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Margin="5" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Border Grid.Column="1">
                <StackPanel>
                    <TextBlock Text="{Binding RunesList.CurrentSelection}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </dh:DialogHost>

</Window>