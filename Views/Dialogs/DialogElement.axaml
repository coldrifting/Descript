<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dialog="clr-namespace:Descript.ViewModels.Dialog"
             xmlns:models="clr-namespace:Descript.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Descript.Views.Dialogs.DialogElement"
             x:DataType="dialog:ViewModelDialogElement">

    <StackPanel Classes.dialog="True">
        <StackPanel Orientation="Vertical">
            <TextBlock Text="Guess Element" Classes.title="True" />
            <Border Classes.titleGlyph="True">
                <TextBlock Text="{Binding Glyph}" Classes.displaysRunes="True" />
            </Border>
        </StackPanel>
        <Grid
            RowDefinitions="50,50"
            ColumnDefinitions="100,200"
            Margin="5">
            <Label Grid.Row="0"
                   Grid.Column="0"
                   Content="Translation"
                   VerticalAlignment="Center" />
            <TextBox Grid.Row="0"
                     Grid.Column="1"
                     Text="{Binding Translation, Mode=TwoWay}"
                     VerticalAlignment="Center" />
            <Label Grid.Row="1"
                   Grid.Column="0"
                   Content="Confidence"
                   VerticalAlignment="Center" />
            <ComboBox Grid.Row="1"
                      Grid.Column="1"
                      Width="200"
                      ItemsSource="{x:Static models:ConfidenceLevelEx.All}"
                      SelectedValue="{Binding Confidence, Mode=TwoWay}"
                      VerticalAlignment="Center">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>
        <Grid ColumnDefinitions="*,*">
            <Button Grid.Column="0" Content="Cancel" IsCancel="True" Command="{Binding CancelCommand}" />
            <Button Grid.Column="1"
                    Classes="accent"
                    Content="Submit"
                    Command="{Binding SubmitCommand}"
                    IsEnabled="{Binding IsValid}"
                    HorizontalAlignment="Right"
                    Margin="2" />
        </Grid>
    </StackPanel>
</UserControl>