<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dialog="clr-namespace:Descript.ViewModels.Dialog"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Descript.Views.Dialogs.DialogPhrase"
             x:DataType="dialog:ViewModelDialogPhrase">

    <StackPanel Classes.dialog="True">
        <StackPanel Orientation="Vertical">
            <TextBlock Text="Guess Word" Classes.title="True" />
            <Border Classes.titleGlyph="True">
                <TextBlock Text="{Binding Glyphs}" Classes.displaysRunes="True" />
            </Border>
        </StackPanel>
        <Grid ColumnDefinitions="Auto,*" Margin="5 20">
            <Label Grid.Column="0"
                   Content="Translation"
                   VerticalAlignment="Center" />
            <TextBox Grid.Column="1"
                     Text="{Binding Translation, Mode=TwoWay}"
                     VerticalAlignment="Center" />
        </Grid>
        <Grid ColumnDefinitions="*,*">
            <Button Grid.Column="0" Content="Cancel" IsCancel="True" Command="{Binding CancelCommand}" />
            <Button Grid.Column="1"
                    Classes="accent"
                    Content="Update"
                    Command="{Binding SubmitCommand}"
                    HorizontalAlignment="Right"
                    Margin="2" />
        </Grid>
    </StackPanel>
</UserControl>