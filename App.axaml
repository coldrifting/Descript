<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogHostAvalonia="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             x:Class="Descript.App"
             RequestedThemeVariant="Dark"
             x:Name="Descript">
    
    <Application.Resources>
        <FontFamily x:Key="TunicRunesFont">avares://Descript/Assets/Fonts#Tunic Runes</FontFamily>
    </Application.Resources>
    
    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="RoyalBlue" />
                <ColorPaletteResources x:Key="Dark" Accent="Teal" />
            </FluentTheme.Palettes>
        </FluentTheme>
        
        <dialogHostAvalonia:DialogHostStyles />
        
        <StyleInclude Source="Styles/Fonts.axaml"/>
        <StyleInclude Source="Styles/ButtonCancel.axaml"/>
        <StyleInclude Source="Styles/Menubar.axaml"/>
        <StyleInclude Source="Styles/Dialog.axaml"/>
        <StyleInclude Source="Styles/ButtonGridItem.axaml"/>
        <StyleInclude Source="Styles/Sentences.axaml"/>
    </Application.Styles>
</Application>