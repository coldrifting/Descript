<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogHostAvalonia="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             x:Class="Descript.App"
             RequestedThemeVariant="Dark">
  
    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="RoyalBlue" />
                <ColorPaletteResources x:Key="Dark" Accent="Teal" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <dialogHostAvalonia:DialogHostStyles />
        <StyleInclude Source="AppStyles.axaml" />
    </Application.Styles>
             
    <Application.Resources>
        <FontFamily x:Key="TunicRunesFont">
            avares://Descript/Assets/Fonts#Tunic Runes
        </FontFamily>
    </Application.Resources>
</Application>